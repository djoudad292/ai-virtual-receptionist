{
  "version": 1,
  "description": "Golden set for the public /try demo conversation (ai-virtual-receptionist frontend). 69 curated cases / ~84 turn assertions across 15 categories. Every turn asserts against the receptionist reply text, suggested chips, and the booking-flow step after that turn. Severity 'critical' cases must all pass before a deploy.",
  "categories": {
    "hours": "opening-hours questions",
    "prices": "pricing and payment questions",
    "booking": "full multi-turn booking flows",
    "urgency": "red-flag symptoms outrank booking intent",
    "human": "handover to a person",
    "insurance": "insurance and finance",
    "treatments": "capability questions about services",
    "location": "address, parking, directions",
    "contact": "phone/email contact",
    "smalltalk": "greetings, thanks, identity",
    "offtopic": "graceful degradation on out-of-scope input",
    "edge": "empty, emoji, case, whitespace",
    "flowtrap": "mid-flow questions, name/slot validation, injection",
    "voice": "short spoken-style utterances (Talk mode transcripts)",
    "repair": "topic switching across turns"
  },
