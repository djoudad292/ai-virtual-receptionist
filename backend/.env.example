# Server
PORT=4000

# Postgres connection string (Neon, Supabase, or any Postgres with pgvector)
DATABASE_URL=postgresql://user:password@host/dbname

# AI
# OpenRouter powers the LLM chat (answers, intent detection, lead capture, appointments, routing)
# Tool-calling (capture_lead, book_appointment, send_confirmation_email) is used automatically
# and falls back to Gemini's function calling when OpenRouter is unavailable.
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=google/gemini-2.5-flash

# Gemini fallback for tool-calling when OpenRouter is unset / out of credits.
# Free tier supports function calling.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# SMTP for the send_confirmation_email tool. Leave SMTP_HOST empty to log emails
# to the server console instead of actually sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=AI Virtual Receptionist
MAIL_FROM_EMAIL=no-reply@receptionist.djaouad.tech

# Embeddings: OpenAI text-embedding-3-small is recommended.
# Retrieval modes:
#   vector           — real OpenAI embeddings, cosine similarity (normal path)
#   keyword-degraded — OpenAI unavailable; retrieval falls back to keyword
#                      (ILIKE term-overlap) scoring. Honest but less recall on
#                      paraphrases. Reported per answer as retrievalMode.
#   hash-fallback    — only when ALLOW_HASH_EMBEDDINGS=true. Hash vectors carry
#                      no semantic signal, so they are never used for vector
#                      search; retrieval degrades to keyword as well.
# Without OPENAI_API_KEY and with ALLOW_HASH_EMBEDDINGS unset, the app still
# answers: it never crashes and never returns a nonsense vector.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Opt-in only. "true" lets the app serve deterministic hash vectors when OpenAI
# embeddings fail. Default "false" = fail loudly and degrade to keyword search.
# Check the live mode at GET /health/embeddings (public).
ALLOW_HASH_EMBEDDINGS=false

# Cosine floor for the vector path (default 0.2). Raise it to trade recall for
# precision; the offline goldset eval reports the curve. See `npm run eval`.
RAG_SIMILARITY_THRESHOLD=

# Optional LLM price table in USD per 1M tokens, for GET /metrics/ai cost estimates.
# LLM_PRICE_TABLE={"google/gemini-2.5-flash":{"prompt":0.3,"completion":2.5}}
# Or, for a single price:
# LLM_PRICE_PROMPT_PER_1M=
# LLM_PRICE_COMPLETION_PER_1M=

# App URL (sent as HTTP-Referer to OpenRouter)
APP_URL=http://localhost:4000

# Auth secrets
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
