# Server
PORT=4000

# Postgres connection string (Neon, Supabase, or any Postgres with pgvector)
DATABASE_URL=postgresql://user:password@host/dbname

# AI
# OpenRouter powers the LLM chat (answers, intent detection, lead capture, appointments, routing)
# Tool-calling (capture_lead, book_appointment, send_confirmation_email) is used automatically
# and falls back to Gemini's function calling when OpenRouter is unavailable.
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=google/gemini-2.5-flash

# Gemini fallback for tool-calling when OpenRouter is unset / out of credits.
# Free tier supports function calling.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# SMTP for the send_confirmation_email tool. Leave SMTP_HOST empty to log emails
# to the server console instead of actually sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=AI Virtual Receptionist
MAIL_FROM_EMAIL=no-reply@receptionist.djaouad.tech

# Embeddings: OpenAI text-embedding-3-small is recommended.
# If OPENAI_API_KEY is empty, a deterministic local hashing fallback is used (still 1536-dim).
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# App URL (sent as HTTP-Referer to OpenRouter)
APP_URL=http://localhost:4000

# Auth secrets
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
